# Desarrollo local: sin credenciales predeterminadas. Crear usuarios con CLI Docker.
LIVE_ENABLED=false
# Política exacta administrada fuera de la base de datos (vacía por defecto).
IACP_ALLOWED_TARGETS=[]
LOCAL_UID=1000
LOCAL_GID=1000

# Opcional: inyección runtime explícita por el operador, con montaje readonly privado.
# No basta añadir estas variables al .env si Compose no las propaga al contenedor.
# IACOC_READER_CREDENTIAL_FILE=/run/secrets/iacoc-reader
# IACOC_READER_WORKSPACE=espacio-local-autorizado

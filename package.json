{
  "name": "iacp-operation-center",
  "version": "0.6.3-rc.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --experimental-strip-types scripts/start-server.mjs .artifacts/build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "ipaddr.js": "^2.5.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
